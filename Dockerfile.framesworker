# syntax=docker/dockerfile:1

# ---------- Build stage ----------
ARG GO_VERSION=1.26.2
FROM golang:${GO_VERSION}-alpine AS build

ARG VERSION=dev

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .

RUN CGO_ENABLED=0 GOOS=linux go build \
    -trimpath \
    -ldflags="-s -w -X github.com/Omotolani98/framesctl/internals/version.Version=${VERSION}" \
    -o /out/framesworker \
    ./cmd/framesworker

# ---------- Runtime stage ----------
FROM debian:bookworm-slim

ARG VERSION=dev

LABEL org.opencontainers.image.title="framesworker" \
      org.opencontainers.image.description="framesctl FFmpeg HLS transcoding worker" \
      org.opencontainers.image.source="https://github.com/Omotolani98/framesctl" \
      org.opencontainers.image.version="${VERSION}"

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates ffmpeg \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --system --uid 10001 framesworker

COPY --from=build /out/framesworker /usr/local/bin/framesworker

USER framesworker:framesworker

ENTRYPOINT ["/usr/local/bin/framesworker"]
