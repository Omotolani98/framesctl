  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^19.2.18",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@opentui/core": "^0.4.5",
    "@opentui/react": "^0.4.5",
    "@tuiparts/react": "^0.0.5",
    "react": "^19.2.8"
  }
}
